--TEST--
Integration of fixers: native_function_invocation,global_namespace_import.
--RULESET--
{"native_function_invocation": {"include": ["@all"]}, "global_namespace_import": {"import_functions": true}}
--REQUIREMENTS--
{"php": 80100}
--EXPECT--
<?php

namespace Test;
use function array_values;

$fn = array_values(...);
$values = array_values([]);

--INPUT--
<?php

namespace Test;

$fn = array_values(...);
$values = array_values([]);
